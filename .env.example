# ==============================================================================
# Cloudflare Workers AI Configuration (OpenAI-Compatible Endpoint)
# ==============================================================================
OPENAI_API_BASE=https://api.cloudflare.com/client/v4/accounts/YOUR_CLOUDFLARE_ACCOUNT_ID_HERE/ai/v1
OPENAI_API_KEY=your_cloudflare_api_token_here
OPENAI_MODEL_NAME=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2048

# ==============================================================================
# Application & Microservice Settings
# ==============================================================================
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["*"]

# ==============================================================================
# PostgreSQL Database (Conversation Memory Persistence)
# ==============================================================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/subtracker

# Core Subscription Microservice (Spring Boot)
SUBSCRIPTION_SERVICE_BASE_URL=http://localhost:8082
SUBSCRIPTION_SERVICE_TIMEOUT_SECONDS=5.0
USE_MOCK_FALLBACK_IF_SERVICE_OFFLINE=true

# Guardrails Configuration
GUARDRAIL_STRICT_DOMAIN_MODE=true
GUARDRAIL_REJECTION_THRESHOLD=0.75
